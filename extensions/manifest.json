{
    "manifest_version": 3,
    "name": "PhishingShield",
    "version": "1.0.0",
    "description": "AI-powered phishing detection for Gmail and LinkedIn",
    "permission": [
        "activeTab",
        "storage",
        "webNavigation",
        "tabs"
    ],
    "host_permissions":[
        "*://*.gmail.com/*",
        "*://*.linkedin.com/*"
    ],
    "background":{
        "service_worker":"background.js"
    },
    "content_scripts":[
        {
            "matches":["*://mail.google.com/*"],
            "js": ["content-scripts/gmail.js"]
        },
        {
            "matches":["*://*.linkedin.com/*"],
            "js":["content-scripts/linkedin.js"]
        }
    ],
    "action":{
        "default_popup":"popup/popup.html",
        "default_icon":{
            "16":"assets/icon16.png",
            "48":"assets/icon48.png",
            "128":"assets/icon128.png"
        }
    }
}